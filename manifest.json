{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.eyecare.dbx",
  "name": "Eye眼",
  "version": "0.2.3",
  "publisher": "xyun2028",
  "description": "在 DBX 里调屏幕色温与滤色：可以自己拖的 24 小时曲线、日出日落、每块屏各调各的、20-20-20 休息提醒；超过两分钟没碰键鼠就暂停计时。Windows、macOS、Linux 与 ARM 机器都能用",
  "source": "https://github.com/xyun2028/dbx-eyecare",
  "homepage": "https://github.com/xyun2028/dbx-eyecare#readme",
  "icon": "ui/icon.png",
  "engines": {
    "host_api": "1.4"
  },
  "permissions": [
    "host.workbench",
    "host.events"
  ],
  "entrypoints": {
    "backend": {
      "executable": "bin/windows-x64/eyecare-sidecar.exe"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.eyecare.dbx.console",
      "label": "Eye眼",
      "icon": "ui/icon.png"
    }
  ]
}
