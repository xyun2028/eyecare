{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eyecare",
  "version": "0.1.0",
  "identifier": "com.anjun.eyecare",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "护眼 · eyecare",
        "width": 880,
        "height": 488,
        "visible": false,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 400,
        "center": true,
        "skipTaskbar": false,
        "backgroundColor": "#0d0f13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
